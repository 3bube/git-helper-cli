{
  "type": "module",
  "name": "git-helper-cli",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/3bube/git-helper-cli"
  },
  "homepage": "https://github.com/3bube/git-helper-cli#readme",
  "bugs": {
    "url": "https://github.com/3bube/git-helper-cli/issues"
  },
  "main": "./dist/index.js",
  "bin": {
    "git-helper": "dist/index.js"
  },
  "files": [
